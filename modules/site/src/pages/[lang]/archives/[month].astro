---
import Base from "../../../layouts/Base.astro";
import Timeline from "../../../components/Timeline.astro";
import { useTranslations, localeProfiles } from "../../../utils/i18n";
import { publishExportDir } from "../../../utils/paths";

import type { TimelinePost } from "../../../components/Timeline.astro";
import { loadArchiveManifest, loadArchiveMonth } from "../../../utils/exportData";

export function getStaticPaths() {
  const languages = Object.keys(localeProfiles);
  const paths = [];

  for (const lang of languages) {
    // Missing or invalid archive manifests hard-fail the build via the shared loader.
    const archives = loadArchiveManifest(publishExportDir, lang);

    for (const archive of archives) {
      paths.push({
        params: { lang, month: archive.archive_month },
        props: { fileName: archive.file_name },
      });
    }
  }

  return paths;
}

const { lang = "zh", month } = Astro.params;
const { fileName } = Astro.props;
const t = useTranslations(lang);

// Read the archive list for this month; missing or invalid files hard-fail.
const archiveItems = loadArchiveMonth(publishExportDir, lang, fileName);

// Map validated catalog items to TimelinePost. There is no display_title
// fallback: summary_short is a required handoff field.
const mappedPosts: TimelinePost[] = archiveItems.map((item) => ({
  slug: item.slug,
  title: item.display_title,
  publishDate: new Date(item.source_published_at),
  description: item.summary_short,
}));

const pageTitle = `UAP Aggregator - ${t('archive.monthTitle', { month })}`;
const pageDesc = t('meta.archiveMonthDesc', { month });
---

<Base title={pageTitle} description={pageDesc} lang={lang}>
  <section class="mt-4">
    <div class="mb-8">
      <h1 class="font-serif text-3xl font-bold text-textColor mb-2">
        {t('archive.monthTitle', { month })}
      </h1>
      <p class="text-sm text-textColor/60 font-sans">
        {pageDesc} ({t('archive.totalItems', { count: archiveItems.length })})
      </p>
    </div>

    {archiveItems.length > 0 ? (
      <Timeline posts={mappedPosts} lang={lang} />
    ) : (
      <p class="text-textColor/60 font-sans">{t('archive.empty')}</p>
    )}
  </section>
</Base>
