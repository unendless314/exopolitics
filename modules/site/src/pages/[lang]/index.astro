---
import Base from "../../layouts/Base.astro";
import Timeline from "../../components/Timeline.astro";
import { useTranslations, localeProfiles } from "../../utils/i18n";
import { publishExportDir } from "../../utils/paths";
import type { TimelinePost } from "../../components/Timeline.astro";
import { loadLanguageIndex } from "../../utils/exportData";

export function getStaticPaths() {
  return Object.keys(localeProfiles).map((lang) => ({ params: { lang } }));
}

const { lang = "zh" } = Astro.params;
const t = useTranslations(lang);

// 1. Metadata-only ingestion: read the pre-sorted index.json via the shared
// loader. Missing or invalid export files hard-fail the build.
const rawItems = loadLanguageIndex(publishExportDir, lang);

// 2. Limit to latest 300 posts
const displayItems = rawItems.slice(0, 300);

// 3. Map validated catalog items to the TimelinePost interface. There is no
// display_title fallback: summary_short is a required handoff field.
const displayPosts: TimelinePost[] = displayItems.map((item) => ({
  slug: item.slug,
  title: item.display_title,
  publishDate: new Date(item.source_published_at),
  description: item.summary_short,
}));

const pageTitle = `UAP Aggregator - ${t('nav.timeline')}`;
const pageDesc = t('meta.homeDesc');
---

<Base title={pageTitle} description={pageDesc} lang={lang}>
  <section class="mt-4">
    <div class="mb-8">
      <h1 class="font-serif text-3xl font-bold text-textColor mb-2">
        {t('nav.timeline')}
      </h1>
      <p class="text-sm text-textColor/60 font-sans">
        {pageDesc}
      </p>
    </div>
    
    <Timeline posts={displayPosts} lang={lang} />
  </section>
</Base>
