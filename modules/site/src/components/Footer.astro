---
import { useTranslations, formatAbsoluteDateTime, localeProfiles } from "../utils/i18n";
import { publishExportDir, publishExportPointer } from "../utils/paths";
import { loadStats } from "../utils/exportData";

const lang = Astro.currentLocale || "zh";
const t = useTranslations(lang);
// Kept for its hard-fail side effect: a missing or invalid stats.json must
// break the build even though the Footer no longer reads a value from it.
loadStats(publishExportDir, Object.keys(localeProfiles));
// Phase B1: the freshness signal lives on the pointer; stats.json stays
// frozen at the generation's build time on no-change runs.
const lastRun = publishExportPointer.last_successful_run_at;
---

<footer class="w-full border-t border-hairline py-8 mt-12 bg-bgColor transition-colors duration-300">
  <div class="mx-auto max-w-4xl px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-sans text-textColor/60">
    <div>
      <p>&copy; {new Date().getFullYear()} UAP Aggregator. All rights reserved.</p>
    </div>
    <div class="text-center md:text-right">
      <p>{t('stats.lastRun')}: <time datetime={lastRun} class="font-mono">{formatAbsoluteDateTime(lastRun)}</time></p>
    </div>
  </div>
</footer>
